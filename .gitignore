# --- Beads issue tracker (Dolt-backed) ---
# Issues live in a local Dolt database synced via `bd dolt push`, not committed
# files. bd writes a detailed .beads/.gitignore on init; these are a safety net
# for the db + per-machine runtime before that exists. config.yaml/metadata.json
# stay trackable.
.beads/embeddeddolt/
.beads/dolt/
.beads/proxieddb/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
.beads-credential-key

# --- Dependencies (submodules manage their own; ignore any at root) ---
node_modules/
.venv/
venv/
__pycache__/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.log

# --- Local, per-user harness state (keep the pointers, ignore the state) ---
.claude/settings.local.json
